# ── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database (Neon PostgreSQL) ───────────────────────────
# Get both URLs from Neon dashboard → Connection Details
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-red-thunder-adexomlc.c-2.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-red-thunder-adexomlc.c-2.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ── Frontend URL ─────────────────────────────────────────
# Local dev:
FRONTEND_URL=http://localhost:5000
# Production (update after deploying to Render):
# FRONTEND_URL=https://daniel-muendo.onrender.com

# ── Auth ─────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# ── Email (Gmail SMTP) ───────────────────────────────────
# 1. Enable 2FA on your Gmail account
# 2. Go to Google Account → Security → App Passwords → create one
# 3. Paste the 16-char app password below (no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=danmuendo4@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
EMAIL_FROM="Daniel Muendo <danmuendo4@gmail.com>"
ADMIN_EMAIL=danmuendo4@gmail.com

# ── Stripe (card payments) ───────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_CURRENCY=kes

# ── Intasend (M-Pesa) ────────────────────────────────────
# Get from https://sandbox.intasend.com → Settings → API Keys
INTASEND_PUBLISHABLE_KEY=your_intasend_publishable_key
INTASEND_SECRET_KEY=your_intasend_secret_key
INTASEND_TEST_MODE=true
